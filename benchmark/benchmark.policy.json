{
  "policy_version": "1.0.0",
  "status": "PROPOSED_NOT_BENCHMARKED",
  "date": "2026-09-30",
  "purpose": "base_raw_development_differential_evaluation",
  "engines_required": [
    "ours",
    "darktable",
    "rawtherapee"
  ],
  "stages": {
    "pilot": {
      "target_unique_raws": 12,
      "holdout_fraction": 0.0
    },
    "standard": {
      "target_unique_raws_total": 40,
      "holdout_fraction": 0.3,
      "includes_pilot": true,
      "auto_continue_after_valid_pilot": true
    },
    "extended": {
      "enabled": false,
      "target_unique_raws_total": 100
    }
  },
  "sampling": {
    "seed": 20260930,
    "split_group": "scene_session",
    "camera_scope": "INHERIT_REPOSITORY_ELSE_PROPOSE",
    "require_xtrans": false,
    "prefer_diverse_cfa_when_relevant": true,
    "desired_scene_tags": [
      "daylight",
      "high_contrast",
      "shadows",
      "fine_detail",
      "low_light",
      "indoor_mixed",
      "portrait"
    ],
    "unknown_labels_allowed": true,
    "fill_missing_categories_with_guesses": false,
    "failed_selected_files_remain_in_matrix": true
  },
  "acquisition": {
    "auto_accept_license_ids_after_per_file_evidence": [
      "CC0-1.0"
    ],
    "other_license_action": "PENDING_REVIEW",
    "fivek_default": "PENDING_LICENSE_REVIEW",
    "allowed_url_schemes": [
      "https"
    ],
    "allow_http_after_recorded_source_review": true,
    "reject_private_network_urls": true,
    "download_concurrency": 1,
    "minimum_request_interval_seconds": 2,
    "connect_timeout_seconds": 20,
    "read_timeout_seconds": 90,
    "max_download_attempt_seconds": 360,
    "max_retries": 2,
    "max_download_bytes_total": 6442450944,
    "max_raw_file_bytes": 268435456,
    "max_megapixels": 120,
    "stream_byte_limit_required": true,
    "allow_automatic_archive_bulk_download": false,
    "upload_images_externally": false
  },
  "resources": {
    "max_corpus_and_output_bytes": 32212254720,
    "minimum_free_bytes": 10737418240,
    "render_concurrency": 1,
    "cpu_thread_budget": 4,
    "gpu_mode": "OFF_WHEN_VERIFIABLE_ELSE_RECORD_LIMITATION",
    "render_timeout_seconds": 240,
    "automatic_privilege_escalation": false,
    "timeout_is_quality_failure": false
  },
  "render": {
    "primary_mode": "BASE_CONTROLLED",
    "optional_default_render_enabled": false,
    "require_effective_settings_evidence": true,
    "isolate_config_cache_and_sidecars": true,
    "source_readonly_or_verified_working_copy": true,
    "full_resolution": true,
    "minimum_measurement_channel_bits": 16,
    "float_measurement_output_allowed": true,
    "jpeg_as_measurement_input": false,
    "creative_look": "OFF_OR_IDENTITY",
    "exposure_ev": 0,
    "white_balance_policy": "AS_SHOT_RESOLVED_PER_ENGINE",
    "primary_pairwise_autotone_match": false
  },
  "normalization": {
    "target": "SDR_sRGB_WITH_PINNED_PROFILE_AND_VERIFIED_TRANSFORM",
    "measurement_data": "float32_or_higher_after_verified_16bit_or_float_input",
    "unknown_profile_action": "BLOCK_COLOR_METRICS_UNLESS_VERIFIED_CONTRACT",
    "preserve_native_export": true,
    "silent_8bit_conversion": false,
    "primary_alignment": "VERIFIED_ORIENTATION_INTEGER_TRANSLATION_ACTIVE_CROP_ONLY",
    "unresolved_alignment": "NOT_COMPARABLE",
    "primary_geometric_warp": false,
    "overview_long_edge_pixels": 1600,
    "crop_source_pixels": 512,
    "thumbnail_used_for_detail_metrics": false
  },
  "triage": {
    "status": "EXPLORATORY_RULES_NOT_ACCEPTANCE_THRESHOLDS",
    "domain_for_endpoint_metrics": "encoded_sRGB_0_1",
    "near_white_threshold": 0.995,
    "near_black_threshold": 0.005,
    "endpoint_excess_vs_each_reference_fraction": 0.02,
    "endpoint_rule_required_valid_references": 2,
    "luminance_domain": "linear_sRGB",
    "luminance_coefficients": [
      0.2126,
      0.7152,
      0.0722
    ],
    "minimum_median_y_for_log_ratio": 0.01,
    "median_luminance_difference_ev_for_review": 0.5,
    "cross_engine_pixel_metrics_are_acceptance_tests": false,
    "max_suggested_review_items_on_summary": 20,
    "nonflagged_review_sample_fraction": 0.2
  },
  "repeatability": {
    "fixture_count": 3,
    "fresh_process_runs_per_fixture_per_engine": 3,
    "compare_pre_jpeg": true,
    "same_engine_tolerance": "INHERIT_VERIFIED_CONTRACT_AND_RECORD",
    "call_fresh_process_cold_os_cache": false,
    "report_p95_from_three_runs": false
  },
  "report": {
    "offline": true,
    "use_external_cdn": false,
    "blind_mapping_separate": true,
    "include_all_planned_cases": true,
    "default_human_review_status": "NOT_REVIEWED",
    "auto_approve_G2": false,
    "camera_certification_from_this_run": false,
    "overall_aesthetic_score": false,
    "source_gps_or_serial_in_gallery": false
  }
}
